<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenGateway"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="96dp"
                android:text="@string/gateway"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDialerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/dialer_status_phone_available_gateway_not_ready"
            android:textColor="@color/dialer_status_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button android:id="@+id/tabRecents" style="@style/DialerTab" android:text="@string/tab_recents" />
        <Button android:id="@+id/tabContacts" style="@style/DialerTab" android:text="@string/tab_contacts" />
        <Button android:id="@+id/tabKeypad" style="@style/DialerTab" android:text="@string/tab_keypad" />
        <Button android:id="@+id/tabRecordings" style="@style/DialerTab" android:text="@string/tab_recordings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/panelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/listContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/panelKeypad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etDialNumber"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/input_bg"
                    android:gravity="center"
                    android:hint="@string/phone_number"
                    android:inputType="phone"
                    android:maxLength="64"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="3">

                    <Button android:id="@+id/btnDial1" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_1" />
                    <Button android:id="@+id/btnDial2" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_2" />
                    <Button android:id="@+id/btnDial3" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_3" />
                    <Button android:id="@+id/btnDial4" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_4" />
                    <Button android:id="@+id/btnDial5" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_5" />
                    <Button android:id="@+id/btnDial6" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_6" />
                    <Button android:id="@+id/btnDial7" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_7" />
                    <Button android:id="@+id/btnDial8" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_8" />
                    <Button android:id="@+id/btnDial9" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_9" />
                    <Button android:id="@+id/btnDialStar" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:contentDescription="@string/dial_star_accessibility" android:text="@string/dial_star" />
                    <Button android:id="@+id/btnDial0" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:text="@string/dial_0" />
                    <Button android:id="@+id/btnDialHash" style="@style/DialButton" android:layout_width="0dp" android:layout_columnWeight="1" android:contentDescription="@string/dial_hash_accessibility" android:text="@string/dial_hash" />
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDialBackspace"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_secondary_button_bg"
                        android:textColor="#FFFFFF"
                        android:text="@string/delete_digit" />

                    <Button
                        android:id="@+id/btnPlaceCall"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="2"
                        android:background="@drawable/call_accept_button_bg"
                        android:text="@string/place_call"
                        android:textColor="@color/on_call_accept" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
