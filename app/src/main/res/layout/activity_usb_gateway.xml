<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gateway_hero_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/agentcall_brand_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="AgentCall Gateway"
                    android:textColor="@color/hero_text_primary"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Private USB bridge for calls, audio, and phone data"
                    android:textColor="@color/hero_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvUsbBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/status_panel_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="Waiting for desktop"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsbConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-medium"
                android:text="USB gateway stopped"
                android:textColor="@color/text_primary"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/tvUsbDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnUsbToggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/primary"
                android:text="Connect desktop"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/GatewaySectionTitle" android:text="Desktop pairing" />
        <TextView android:id="@+id/tvControllerEnrollment" style="@style/GatewayStatusRow" android:text="Desktop · Not paired" />
        <Button android:id="@+id/btnControllerForget" style="@style/GatewayDangerButton" android:text="Forget paired desktop" />

        <TextView style="@style/GatewaySectionTitle" android:text="System readiness" />
        <TextView android:id="@+id/tvDeviceGate" style="@style/GatewayStatusRow" />
        <TextView android:id="@+id/tvTelecomGate" style="@style/GatewayStatusRow" />
        <TextView android:id="@+id/tvAudioGate" style="@style/GatewayStatusRow" />
        <TextView android:id="@+id/tvRecordingGate" style="@style/GatewayStatusRow" />

        <TextView
            style="@style/GatewaySectionTitle"
            android:text="@string/project" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGithub"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/agentcall_on_github"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:icon="@drawable/ic_github"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/text_primary" />

        <LinearLayout
            android:id="@+id/callCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCallState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvCallNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button android:id="@+id/btnAnswer" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Answer" android:textAllCaps="false" android:backgroundTint="@color/call_accept" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnReject" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Reject" android:textAllCaps="false" android:backgroundTint="@color/call_end" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnHangup" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="End" android:textAllCaps="false" android:backgroundTint="@color/call_end" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:lineSpacingExtra="2dp"
            android:text="How it works\nAuthorize USB debugging once, then tap Connect desktop. Pairing, call-log sync, contact sync, and local USB setup continue automatically. No Wi-Fi, LAN, SIP, or automatic calling is used. Calls stay blocked until the desktop confirms recording health."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
