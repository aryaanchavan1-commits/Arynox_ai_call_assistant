#!/bin/sh
set -eu

output=${1:-}
[ -n "$output" ] || { printf 'usage: agentcall-backup-state OUTPUT.tar.gz\n' >&2; exit 2; }
case "$output" in /*) ;; *) printf 'output must be an absolute path\n' >&2; exit 2;; esac
[ ! -e "$output" ] || { printf 'refusing to overwrite existing backup\n' >&2; exit 1; }

state=${AGENTCALL_STATE_DIR:-/var/lib/agentcall}
config=${AGENTCALL_CONFIG_DIR:-/etc/agentcall}
[ -d "$state" ] || { printf 'state directory missing\n' >&2; exit 1; }
[ -d "$config" ] || { printf 'config directory missing\n' >&2; exit 1; }

umask 077
tmp=${output}.partial.$$
trap 'rm -f "$tmp"' EXIT INT TERM
# Archive path names, not external symlink targets. Keep credentials protected.
tar --one-file-system --numeric-owner --acls --xattrs -czf "$tmp" \
  -C / "${state#/}" "${config#/}"
mv "$tmp" "$output"
(
  cd "$(dirname "$output")"
  sha256sum "$(basename "$output")" > "$(basename "$output").sha256"
)
trap - EXIT INT TERM
printf '%s\n' "$output"
