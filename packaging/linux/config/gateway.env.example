# Optional overrides for /etc/agentcall/gateway.env, root:agentcall mode 0640.
# A normal first run needs no edits: systemd supplies safe zero-touch defaults,
# the package supplies the public matched-artifact manifest, and private ADB,
# controller, and redaction state stays under /var/lib/agentcall. Pairing uses the
# authenticated bootstrap protocol; never copy an ADB key or controller secret
# into this environment file.
AGENTCALL_MATCHED_ARTIFACT_FILE=/usr/share/agentcall/protocol/matched-artifact.properties
AGENTCALL_CONTROLLER_SECRET_FILE=/var/lib/agentcall/controller/controller.key
AGENTCALL_REDACTION_SALT_FILE=/var/lib/agentcall/redaction-salt
AGENTCALL_ADB_HOME=/var/lib/agentcall/adb
AGENTCALL_ADB_SERVER_SOCKET=tcp:127.0.0.1:15037
AGENTCALL_HOST_PORT=5040
AGENTCALL_PHONE_PORT=27183
AGENTCALL_DIAL_ENABLED=false
# Mandatory Linux recording; health failure blocks dial, answer, and DTMF.
AGENTCALL_RECORDING_REQUIRED=true
AGENTCALL_RECORDING_ROOT=/var/lib/agentcall/recordings
AGENTCALL_RECORDING_MIN_FREE_BYTES=1073741824
AGENTCALL_FFMPEG_PATH=/usr/bin/ffmpeg
AGENTCALL_REALTIME_ENABLED=false
AGENTCALL_CALLER_MEMORY_ENABLED=false
AGENTCALL_CALLER_MEMORY_ROOT=/var/lib/agentcall/caller-memory

# Provider and dial policy overrides are intentionally absent. Add them only
# through the reviewed operator UI/policy path; never place controller keys,
# ADB private keys, raw phone numbers, or private signing material here.
