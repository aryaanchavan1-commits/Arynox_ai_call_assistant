# Exact qualified POCO M2 Pro ADB identities observed on the supported tuple.
# 4ee2 exposes the recorded ff:ff:00 + ff:42:01 ADB-capable USB mode; 4ee7 is
# the previously qualified mode. Never broaden to MODE=0666 or plugdev.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4ee2", GROUP="agentcall", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4ee7", GROUP="agentcall", MODE="0660", TAG+="uaccess"
