{
  "name": "@sidinsearch/agentcall-pc-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "AgentCall USB-only PC gateway and local MCP server for cellular calling. No SIP/RTP/Asterisk/STUN/LAN/Wi-Fi/WSS.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/gateway.js",
    "./adb-manager.js": "./src/adb-manager.js",
    "./device-client.js": "./src/device-client.js",
    "./policy.js": "./src/policy.js",
    "./framing.js": "./src/framing.js",
    "./mcp-server.js": "./src/mcp-server.js"
  },
  "bin": {
    "agentcall-mcp": "./src/mcp-server.js",
    "agentcall-gatewayd": "./src/gatewayd.js"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec test/*.test.js",
    "check": "node scripts/check.mjs test/*.test.js",
    "qualify:live-conversation": "node scripts/live-conversation-qualification.js",
    "qualify:hermes-voice": "node scripts/hermes-voice-supervisor.js"
  },
  "dependencies": {
    "ws": "8.21.1"
  }
}
